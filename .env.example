BROKER_PUBLIC_URL=server_ip_or_domain
BROKER_API_PREFIX=secret_prefix_no_one_should_know

# ─────────────────────────────────────────────────────────────────
# Webhook Server
# ─────────────────────────────────────────────────────────────────
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=80

# Seconds an idle keep-alive connection is held open. Must exceed the gap between
# TradingView alerts: TradingView reuses pooled connections, and uvicorn's 5s
# default closes them first — the alert then fails with
# "server closed the connection unexpectedly".
WEBHOOK_KEEPALIVE_TIMEOUT=120

# Seconds the webhook may wait for JetStream to ack the enqueue before it
# answers anyway and retries the enqueue in the background. Must stay well
# under TradingView's own patience, or the alert fails with
# "request took too long and timed out" — TradingView never re-sends it.
WEBHOOK_ENQUEUE_TIMEOUT=1.0

# Callback APIs
BROKER_API_KEY=api_key

# Optional HMAC secret — set the same value in TradingView alert header
# X-Signature: <sha256-hex-of-body>
# Leave blank to disable validation.
WEBHOOK_SECRET=5a7a92a5-7a26-42c7-a981-fd20c0040acf

# ─────────────────────────────────────────────────────────────────
# NATS (JetStream must be enabled on the server: `nats-server -js -sd <dir>`
# — the bundled docker-compose.yml already does this)
# ─────────────────────────────────────────────────────────────────
NATS_HOST=localhost
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_TOKEN=changeme

# ─────────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=algo_trading_broker
POSTGRES_USER=algo_trading
POSTGRES_PASSWORD=algotrading_broker_db_password

# ─────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────
# API Docs (Swagger UI /docs, ReDoc /redoc, schema /openapi.json)
# Set to false in production to hide the interactive docs entirely.
# ─────────────────────────────────────────────────────────────────
DOCS_ENABLED=false

# ─────────────────────────────────────────────────────────────────
# Telegram
# TELEGRAM_BROKER_LOG_CHAT_IDS is for individual chat, manage service, NATS broker notifications, etc.
# TELEGRAM_PRIVATE_BROADCAST_CHAT_IDS is the **private** audience of the
# signal-cycle broadcast: an operator-facing copy that additionally carries
# the strategy name, signal id, the worker execution table, and (when the
# notification_include_signal_raw broker setting is on) the strategy's raw
# indicator/input dump. The **public** audience (a subscriber-facing copy
# with just the bare price/level/timeline body — no strategy internals, no
# worker table) is edited at runtime from the admin API or the bot's
# /admin_public_chats command, so it lives in broker_settings under
# public_broadcast_chat_ids and has no env var here.
#
# All three chat ids below — TELEGRAM_BROKER_LOG_CHAT_IDS,
# TELEGRAM_PRIVATE_BROADCAST_CHAT_IDS and TELEGRAM_LOG_CHAT_ID — are parsed the
# same way: each may be a comma-separated list to notify several chats at
# once, and any entry may target one topic of a group that has Topics enabled
# by appending "_<topic id>" — the broker then sends message_thread_id so the
# message lands in that topic rather than in General. The two ids are the
# ones in the topic's link, t.me/c/2173777783/924584 → -1002173777783_924584:
#   TELEGRAM_BROKER_LOG_CHAT_IDS="-1001111111111,-1002173777783_924584"
#   TELEGRAM_PRIVATE_BROADCAST_CHAT_IDS="-1002173777783_924584,-1001111111111"
# ─────────────────────────────────────────────────────────────────
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BROKER_LOG_CHAT_IDS=
TELEGRAM_PRIVATE_BROADCAST_CHAT_IDS="-"
# Forward log records at ERROR level or above via a dedicated bot/chat.
# When TELEGRAM_LOG_BOT_TOKEN / TELEGRAM_LOG_CHAT_ID are empty, the hook
# falls back to TELEGRAM_BOT_TOKEN / TELEGRAM_BROKER_LOG_CHAT_IDS — the list/topic syntax
# above applies here too, and to the list it falls back to.
TELEGRAM_LOG_ERRORS_ENABLED=false
TELEGRAM_LOG_BOT_TOKEN=
TELEGRAM_LOG_CHAT_ID=
# Seconds a single Bot API call may take. Where Telegram is throttled or
# filtered the connection is accepted and no response ever comes, so every
# send burns this long before failing. Notifications are delivered off the
# signal path, so this only bounds one stuck send, never a trade.
TELEGRAM_HTTP_TIMEOUT=5.0

# ─────────────────────────────────────────────────────────────────
# Telegram Bot (interactive bot service — folder ./bot)
# Uses its own BotFather bot/token, separate from TELEGRAM_BOT_TOKEN above
# (which is the broker's send-only notification/alert bot). Create a second
# bot via @BotFather and put its token in BOT_TELEGRAM_TOKEN. BOT_BROKER_BASE_URL
# is overridden to http://broker:<port> inside docker-compose. If
# BROKER_API_PREFIX is set, the bot prepends it. Also uses BROKER_API_KEY above.
#
# TELEGRAM_ADMIN_IDS: comma-separated Telegram user IDs that get the admin menu
# and admin commands (/admin_accounts, /admin_trades, /admin_flat, /admin_rotate,
# /admin_linkaccount, /admin_settings). Find your numeric ID via
# @userinfobot. Leave blank = no admins. Example: 123,456
#
# BOT_TELEGRAM_TOKEN is ALSO read by the broker (shared .env): it uses this bot
# to post and update each owner's live trade card (the /subscribe opt-in),
# because a user can only be messaged by the bot they started — this one — not
# the broker's send-only TELEGRAM_BOT_TOKEN bot. Using this bot's token is also
# what makes the card's Detail/Exit buttons work: their taps arrive as callback
# queries on this bot's long poll. Leave empty to disable trade cards.
# ─────────────────────────────────────────────────────────────────
BOT_TELEGRAM_TOKEN=
TELEGRAM_ADMIN_IDS=
BOT_BROKER_BASE_URL=http://localhost:8080
BOT_LOG_LEVEL=INFO
BOT_REQUEST_TIMEOUT=10.0
