{
  "TCP": {
    "443": { "HTTPS": true },
    "4222": { "TCPForward": "nats:4222" },
    "8222": { "TCPForward": "nats:8222" },
    "5432": { "TCPForward": "postgres:5432" }
  },
  "Web": {
    "@TAILSCALE_FQDN@:443": {
      "Handlers": {
        "@WEBHOOK_PATH@": { "Proxy": "http://broker:@WEBHOOK_PORT@" }
      }
    }
  },
  "AllowFunnel": {
    "@TAILSCALE_FQDN@:443": true
  }
}
